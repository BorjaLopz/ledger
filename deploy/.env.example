# Copia a deploy/.env, rellena y protege con: chmod 600 .env
LEDGER_DB_PASSWORD=la_contraseña_de_ledger_user
# Los mismos valores que tenias en el .env de Vite
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Genera uno con: openssl rand -hex 32   (minimo 32 caracteres)
RECEIPTS_SIGNING_SECRET=

# --- Bot de Telegram de gastos ---
# Token que te dio @BotFather al crear el bot de gastos (distinto del de avisos)
TELEGRAM_BOT_TOKEN=
# Tu ID numerico de Telegram (el "chat id" que sacaste con getUpdates)
ALLOWED_TELEGRAM_ID=
# Clave entre el bot y la API. Genera una con: openssl rand -hex 32
BOT_API_KEY=
# Tu uid de Firebase. Sacalo con:
#   docker exec postgres psql -U ledger_user -d ledger -t -A -c "SELECT DISTINCT uid FROM categories;"
BOT_UID=
